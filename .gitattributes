# Normalise line endings in the repository.
* text=auto eol=lf

# PowerShell reads LF as well, so the .ps1 scripts keep it, as on Linux.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.jar  binary
