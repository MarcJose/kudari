SPDX-License-Identifier: MIT

The manifest of the MSIX package; tools/windows-package.ps1 fills in the version and the
publisher, which must be the subject of the certificate that signs the package. The alias
makes `kudari mcp` work on Windows as on Linux.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="io.github.marcjose.kudari" Publisher="@PUBLISHER@" Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Kudari</DisplayName>
    <PublisherDisplayName>Marc Jose</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A drop-down terminal</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Kudari" Executable="kudari.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Kudari" Description="A drop-down terminal"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="kudari.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="kudari.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
