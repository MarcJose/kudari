# All checks but the GUI test, which the CI runs, before every push. Turned on with
#   git config core.hooksPath .githooks
# and skipped once with `git push --no-verify`.
set -eu

cd "$(git rev-parse --show-toplevel)"
# The build output stays out of the source tree unless a directory is given.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/kudari-target}"

tests/check.sh
tools/security.sh
