# The package of a release, as the release workflow built it on Arch Linux. tools/aur.py
# sets the version and the checksum after each release.

pkgname=kudari-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='A drop-down terminal for KDE Plasma on Wayland'
arch=('x86_64')
url='https://github.com/MarcJose/kudari'
license=('MIT')
depends=(
  'glibc' 'libgcc' 'libstdc++' 'hicolor-icon-theme'
  'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'layer-shell-qt' 'qqc2-desktop-style'
  'kcolorscheme' 'kconfig' 'kconfigwidgets' 'kcoreaddons' 'kcrash' 'kdeclarative'
  'kglobalaccel' 'ki18n' 'kio' 'kirigami' 'kirigami-addons' 'knotifications' 'knotifyconfig'
  'kstatusnotifieritem' 'kwidgetsaddons' 'kwindowsystem' 'kxmlgui'
)
provides=('kudari')
conflicts=('kudari')
source_x86_64=("$url/releases/download/v$pkgver/kudari-$pkgver-$CARCH-linux.tar.xz")
sha256sums_x86_64=('abcb6c099fdce604e95761ad914898a77cb57615f3d519c54967d8f537361983')

package() {
  cp -a usr "$pkgdir/"
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s /usr/share/doc/kudari/MIT.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  ln -s /usr/share/doc/kudari/THIRD_PARTY_LICENSES "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES"
}
